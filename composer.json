{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^4.2",
        "laravel/ai": "^0.7.2",
        "laravel/fortify": "^1.30",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "laravel/wayfinder": "^0.1.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "openai-php/client": "^0.18.0",
        "spatie/laravel-data": "^4.20",
        "spatie/laravel-permission": "^6.24",
        "spatie/laravel-typescript-transformer": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^1.8",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "files": [
            "app/Helpers/trans.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#a7f3d0,#fcd34d,#fb7185,#fdba74,#67e8f9\" \"php artisan serve\" \"php artisan queue:listen --queue=default --tries=1 --timeout=60\" \"php artisan queue:listen --queue=recipes-ai-generation --tries=1 --timeout=120\" \"php artisan queue:listen --queue=recipes-images-ai-generation --tries=1 --timeout=300\" \"php artisan pail --timeout=0\" \"npm run dev\" \"cd api/ai-services-adonis && pnpm dev\" --names=server,queue-default,queue-recipes,queue-images,logs,vite,ai-service --kill-others"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#a7f3d0,#fcd34d,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --queue=default --tries=1 --timeout=60\" \"php artisan queue:listen --queue=recipes-ai-generation --tries=1 --timeout=120\" \"php artisan queue:listen --queue=recipes-images-ai-generation --tries=1 --timeout=300\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue-default,queue-recipes,queue-images,logs,ssr --kill-others"
        ],
        "lint": "vendor/bin/pint",
        "test:types": "phpstan analyse --memory-limit=512M",
        "test:coverage": "php artisan test --coverage --min=80",
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
